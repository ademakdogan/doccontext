# gRPC
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=doccontext

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_DOCUMENT_JOBS_QUEUE=document_jobs

# PostgreSQL (job repository)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=doccontext
POSTGRES_PASSWORD=doccontext
POSTGRES_DB=doccontext

# Embeddings / vector store (factory keys)
EMBEDDING_PROVIDER=minilm
VECTOR_STORE_PROVIDER=qdrant

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=160

# LLM (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_ROUTER_MODEL=openai/gpt-5-mini
LLM_ANSWER_MODEL=openai/gpt-5-mini

# Query
QUERY_TOP_K_DEFAULT=5
MAX_CONCURRENT_QUERIES=10

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FILE_INDEX_DOCUMENT=./logs/index_document.log
LOG_FILE_GET_INDEXING_JOB_STATUS=./logs/get_indexing_job_status.log
LOG_FILE_QUERY_DOCUMENTS=./logs/query_documents.log
LOG_FILE_DELETE_DOCUMENT=./logs/delete_document.log
LOG_FILE_WORKER=./logs/document_worker.log
